# ============================================================================
# Environment Configuration - Copy to .env.local for development
# ============================================================================

# Node Environment
NODE_ENV=development

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Key for sensitive data (32 bytes for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# Database
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/indexpilot

# ============================================================================
# Redis (Optional - for production job queue)
# ============================================================================

# Upstash Redis URL (production)
REDIS_URL=redis://default:password@localhost:6379

# ============================================================================
# Google Integration
# ============================================================================

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# Google Cloud Project ID (for Service Account)
GOOGLE_PROJECT_ID=your-project-id

# ============================================================================
# Next.js Configuration
# ============================================================================

# API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# SMTP Configuration for sending emails
SMTP_FROM=noreply@indexpilot.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_TLS=true

# ============================================================================
# Supabase Configuration (Optional)
# ============================================================================

# Supabase URL and keys (alternative to custom JWT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Application Configuration
# ============================================================================

# Maximum concurrent indexing jobs
QUEUE_MAX_CONCURRENT=5

# Default page limit for paginated endpoints
PAGINATION_LIMIT=50

# API rate limit (requests per minute)
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_UNAUTHENTICATED=10

# ============================================================================
# Logging
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable experimental features
FEATURE_EXPERIMENTAL=false

# Enable debug mode
DEBUG=false
